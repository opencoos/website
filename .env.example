# Public site URL, used for canonical URLs, sitemap and Open Graph metadata.
# Defaults to https://opencoos.org; set it for preview or staging deployments.
NEXT_PUBLIC_SITE_URL=

# Community links. Leave empty until configured; the site shows "Pending configuration".
NEXT_PUBLIC_SPEC_REPO_URL=
NEXT_PUBLIC_WEBSITE_REPO_URL=
NEXT_PUBLIC_ISSUES_URL=
NEXT_PUBLIC_DISCUSSIONS_URL=
NEXT_PUBLIC_CONTRIBUTING_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional: read the specification from a separately checked-out repository.
# SPEC_DIR=../coos-spec
